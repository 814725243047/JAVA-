class Student {
    // Instance variable
    String name;

    // Constructor
    Student(String name) {
        this.name = name;
    }

    // Method to display student name
    void display() {
        System.out.println("Name: " + name);
    }

    // Main method
    public static void main(String[] args) {
        // Create a Student object
        Student s1 = new Student("Shree");

        // Display student details
        s1.display();
    }constructor
}
