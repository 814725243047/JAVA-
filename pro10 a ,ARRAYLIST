import java.util.*;  
class ShoppingCart { 
public static void main(String args[]) { 
ArrayList<String> cart = new ArrayList<String>();  cart.add("Laptop"); 
cart.add("Mobile");  
cart.add("Headphones");  
cart.add("Smart Watch");  
