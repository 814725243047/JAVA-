Program 
class EmailValidation { 
public static void main(String args[]) {  
String email = "student@gmail.com"; 
if (email.contains("@") && email.endsWith(".com") && !email.contains(" ")) { System.out.println("Valid Email Address"); 
} 
else { 
System.out.println("Invalid Email Address"); 
} 
System.out.println("Length : " + email.length());  
System.out.println("Upper Case : " + email.toUpperCase()); 
System.out.println("User Name : " + email.substring(0, email.indexOf("@"))); } 
}



